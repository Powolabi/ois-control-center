// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  auditEvents AuditEvent[]
  importRuns  ImportRun[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

enum LocationType {
  HOME_LAB
  CLOUD
  REMOTE_SITE
  OTHER
}

model Location {
  id          String       @id @default(cuid())
  name        String
  type        LocationType
  description String?      @db.Text
  city        String?
  provider    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?

  systems System[]

  @@map("locations")
}

enum SystemType {
  PHYSICAL_SERVER
  PROXMOX_HOST
  VPS
  VIRTUAL_MACHINE
  CONTAINER
  NAS
  STORAGE
  NETWORK_DEVICE
  NETWORK_CONNECTION
  APPLICATION
  WEBSITE
  DATABASE
  SERVICE
  SECURITY_SERVICE
  BLOCKCHAIN_NODE
  OTHER
}

enum SystemStatus {
  ONLINE
  OFFLINE
  WARNING
  MAINTENANCE
  UNKNOWN
  RETIRED
}

enum Criticality {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum Environment {
  PRODUCTION
  STAGING
  DEVELOPMENT
  LAB
}

model System {
  id                  String       @id @default(cuid())
  name                String
  slug                String       @unique
  type                SystemType
  status              SystemStatus @default(UNKNOWN)
  criticality         Criticality
  environment         Environment
  description         String?      @db.Text
  hostname            String?
  privateIp           String?
  publicIp            String?
  operatingSystem     String?
  platformVersion     String?
  vmContainerId       String?
  cpuAllocation       Int?
  memoryAllocation    Int?
  storageAllocation   Int?
  accessMethod        String?
  credentialReference String?
  owner               String?
  tags                String[]
  notes               String?      @db.Text
  lastVerifiedAt      DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  archivedAt          DateTime?

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  parentSystemId String?
  parentSystem   System?  @relation("SystemHierarchy", fields: [parentSystemId], references: [id])
  childSystems   System[] @relation("SystemHierarchy")

  dependenciesFrom Dependency[]              @relation("DependencySource")
  dependenciesTo   Dependency[]              @relation("DependencyTarget")
  endpoints        Endpoint[]
  auditEvents      AuditEvent[]
  externalMappings ExternalResourceMapping[]
  monitors         Monitor[]
  incidents        Incident[]

  @@index([locationId])
  @@index([parentSystemId])
  @@index([type])
  @@index([status])
  @@index([criticality])
  @@index([environment])
  @@map("systems")
}

enum DependencyType {
  DEPENDS_ON
  CONNECTS_TO
  STORES_DATA_ON
  ROUTED_THROUGH
  MONITORED_BY
  BACKED_UP_TO
  PROVIDES_SERVICE_TO
}

model Dependency {
  id          String         @id @default(cuid())
  type        DependencyType
  description String?        @db.Text
  createdAt   DateTime       @default(now())

  sourceSystemId String
  sourceSystem   System @relation("DependencySource", fields: [sourceSystemId], references: [id], onDelete: Cascade)

  targetSystemId String
  targetSystem   System @relation("DependencyTarget", fields: [targetSystemId], references: [id], onDelete: Cascade)

  @@unique([sourceSystemId, targetSystemId, type])
  @@index([sourceSystemId])
  @@index([targetSystemId])
  @@map("dependencies")
}

enum EndpointType {
  URL
  API
  SSH
  MANAGEMENT
  DATABASE
  RPC
  OTHER
}

model Endpoint {
  id        String       @id @default(cuid())
  name      String
  type      EndpointType
  address   String
  port      Int?
  protocol  String?
  isPublic  Boolean      @default(false)
  notes     String?      @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  systemId String
  system   System @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@index([systemId])
  @@map("endpoints")
}

enum AuditAction {
  SYSTEM_CREATED
  SYSTEM_UPDATED
  SYSTEM_ARCHIVED
  SYSTEM_PARENT_CHANGED
  DEPENDENCY_CREATED
  DEPENDENCY_REMOVED
  ENDPOINT_CREATED
  ENDPOINT_UPDATED
  ENDPOINT_REMOVED
  LOCATION_CREATED
  LOCATION_UPDATED
  LOCATION_ARCHIVED
  IMPORT_STARTED
  IMPORT_PREVIEW_GENERATED
  IMPORT_COMPLETED
  IMPORT_FAILED
  IMPORT_SYSTEM_CREATED
  IMPORT_SYSTEM_UPDATED
  IMPORT_MAPPING_CREATED
  IMPORT_CONFLICT_RESOLVED
  MONITOR_CREATED
  MONITOR_UPDATED
  MONITOR_ENABLED
  MONITOR_DISABLED
  MONITOR_ARCHIVED
  MANUAL_CHECK_REQUESTED
  INCIDENT_OPENED
  INCIDENT_ACKNOWLEDGED
  INCIDENT_RESOLVED
  HEARTBEAT_TOKEN_CREATED
  HEARTBEAT_TOKEN_ROTATED
}

model AuditEvent {
  id        String      @id @default(cuid())
  action    AuditAction
  entityId  String
  metadata  Json?
  createdAt DateTime    @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  systemId String?
  system   System? @relation(fields: [systemId], references: [id])

  @@index([entityId])
  @@index([action])
  @@index([userId])
  @@index([systemId])
  @@index([createdAt])
  @@map("audit_events")
}

enum ImportSourceType {
  PROXMOX
}

model ImportSource {
  id                   String           @id @default(cuid())
  name                 String
  type                 ImportSourceType
  sourceIdentifier     String
  lastSuccessfulImport DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  externalMappings ExternalResourceMapping[]
  importRuns       ImportRun[]

  @@unique([type, sourceIdentifier])
  @@index([type])
  @@map("import_sources")
}

enum ExternalResourceType {
  PROXMOX_NODE
  PROXMOX_VM
  PROXMOX_CONTAINER
  PROXMOX_STORAGE
}

model ExternalResourceMapping {
  id                 String               @id @default(cuid())
  externalResourceId String
  externalType       ExternalResourceType
  lastSeenAt         DateTime
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  importSourceId String
  importSource   ImportSource @relation(fields: [importSourceId], references: [id], onDelete: Cascade)

  systemId String
  system   System @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@unique([importSourceId, externalResourceId])
  @@index([importSourceId])
  @@index([systemId])
  @@index([externalResourceId])
  @@map("external_resource_mappings")
}

enum ImportStatus {
  PREVIEWED
  COMPLETED
  COMPLETED_WITH_WARNINGS
  FAILED
  CANCELLED
}

model ImportRun {
  id             String       @id @default(cuid())
  schemaVersion  String
  generatedAt    DateTime
  status         ImportStatus
  totalResources Int
  newCount       Int          @default(0)
  updatedCount   Int          @default(0)
  unchangedCount Int          @default(0)
  missingCount   Int          @default(0)
  conflictCount  Int          @default(0)
  warningCount   Int          @default(0)
  errorSummary   String?      @db.Text
  startedAt      DateTime     @default(now())
  completedAt    DateTime?

  importSourceId String
  importSource   ImportSource @relation(fields: [importSourceId], references: [id], onDelete: Cascade)

  initiatedBy String
  user        User   @relation(fields: [initiatedBy], references: [id])

  @@index([importSourceId])
  @@index([initiatedBy])
  @@index([status])
  @@index([startedAt])
  @@map("import_runs")
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  DOWN
  PAUSED
  UNKNOWN
}

enum CheckType {
  HTTP
  TCP
  HEARTBEAT
}

model Monitor {
  id                   String       @id @default(cuid())
  name                 String
  checkType            CheckType
  enabled              Boolean      @default(true)
  intervalSeconds      Int          @default(60)
  timeoutMs            Int          @default(10000)
  failureThreshold     Int          @default(3)
  recoveryThreshold    Int          @default(2)
  nextCheckAt          DateTime?
  lastCheckedAt        DateTime?
  currentHealth        HealthStatus @default(UNKNOWN)
  consecutiveFailures  Int          @default(0)
  consecutiveSuccesses Int          @default(0)
  workerLeaseOwner     String?
  workerLeaseExpiry    DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  archivedAt           DateTime?

  systemId String
  system   System @relation(fields: [systemId], references: [id], onDelete: Cascade)

  httpConfig      HttpCheckConfig?
  tcpConfig       TcpCheckConfig?
  heartbeatConfig HeartbeatCheckConfig?
  checkResults    CheckResult[]
  incidents       Incident[]

  @@index([systemId])
  @@index([enabled])
  @@index([currentHealth])
  @@index([nextCheckAt])
  @@index([workerLeaseExpiry])
  @@map("monitors")
}

model HttpCheckConfig {
  id                String   @id @default(cuid())
  url               String
  method            String   @default("GET")
  expectedStatusMin Int      @default(200)
  expectedStatusMax Int      @default(299)
  followRedirects   Boolean  @default(true)
  maxRedirects      Int      @default(5)
  validateTls       Boolean  @default(true)
  expectedText      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  monitorId String  @unique
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("http_check_configs")
}

model TcpCheckConfig {
  id        String   @id @default(cuid())
  host      String
  port      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  monitorId String  @unique
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("tcp_check_configs")
}

model HeartbeatCheckConfig {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  monitorId String  @unique
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("heartbeat_check_configs")
}

model CheckResult {
  id               String       @id @default(cuid())
  startedAt        DateTime
  completedAt      DateTime?
  success          Boolean
  healthResult     HealthStatus
  responseTimeMs   Int?
  httpStatus       Int?
  errorCode        String?
  errorSummary     String?      @db.Text
  workerIdentifier String?
  createdAt        DateTime     @default(now())

  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  incidentsOpened   Incident[] @relation("IncidentFirstFailure")
  incidentsResolved Incident[] @relation("IncidentRecovery")

  @@index([monitorId])
  @@index([createdAt])
  @@index([success])
  @@map("check_results")
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Incident {
  id             String         @id @default(cuid())
  status         IncidentStatus @default(OPEN)
  failureSummary String         @db.Text
  openedAt       DateTime       @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  systemId String
  system   System @relation(fields: [systemId], references: [id], onDelete: Cascade)

  firstFailedResultId String
  firstFailedResult   CheckResult @relation("IncidentFirstFailure", fields: [firstFailedResultId], references: [id])

  recoveryResultId String?
  recoveryResult   CheckResult? @relation("IncidentRecovery", fields: [recoveryResultId], references: [id])

  @@index([monitorId])
  @@index([systemId])
  @@index([status])
  @@index([openedAt])
  @@map("incidents")
}
